# GEMINI_API_KEY: Clave de API de Google Gemini para reportes ejecutivos con IA real (modelo gemini-2.5-flash).
# Si se deja vacía o con valor de plantilla, el servidor activa automáticamente el modo Sandbox Resiliente local.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Puerto HTTP del servidor Express (por defecto: 3000).
PORT=3000

# APP_URL: URL pública donde se despliega la aplicación (opcional).
APP_URL="http://localhost:3000"

# --- Piloto 17A (Fase 1) ---
# ORBI_DATA_DIR: carpeta de la base de datos, fotos y respaldos (por defecto ./data). En Docker: /data (volumen).
# ORBI_DATA_DIR=./data
# ORBI_SEED_DEMO: "true" carga OTs y datos de demostración en una base vacía. NO usar en el piloto real.
ORBI_SEED_DEMO=false
# COOKIE_SECURE: "true" cuando el sitio se publica con HTTPS (obligatorio fuera de localhost).
COOKIE_SECURE=false
# TRUST_PROXY: "1" si hay un proxy HTTPS delante (nginx, Caddy, balanceador).
# TRUST_PROXY=1
