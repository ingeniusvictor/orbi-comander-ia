# GEMINI_API_KEY: Clave de API de Google Gemini para reportes ejecutivos con IA real (modelo gemini-2.5-flash).
# Si se deja vacía o con valor de plantilla, el servidor activa automáticamente el modo Sandbox Resiliente local.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Puerto HTTP del servidor Express (por defecto: 3000).
PORT=3000

# APP_URL: URL pública donde se despliega la aplicación (opcional).
APP_URL="http://localhost:3000"
